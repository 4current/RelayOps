#!/usr/bin/env bash
set -euo pipefail

BIN=rigctld-wsjtx
MODEL=2041 #Kenwood TS-890S
CAT_DEV=/dev/tty890A
PORT=4532

if pgrep -af rigctld.*${PORT} >/dev/null; then
  echo "rigctld-ts890 already running"
  exit 0
fi

$BIN -m $MODEL \
  -r $CAT_DEV \
  -s 115200 \
  -t $PORT \
  > "$HOME/rigctld-ts890.log" 2>&1 &

echo "started rigctld ts-890 pid=$!"
