#!/usr/bin/env bash
set -euo pipefail

BIN=rigctld-wsjtx
MODEL=3081
CAT_DEV=/dev/tty9700A
PORT=4533

if pgrep -af rigctld.*${PORT} >/dev/null; then
  echo "rigctld-9700 already running"
  exit 0
fi

$BIN \
  -m $MODEL \
  -r $CAT_DEV \
  -s 115200 \
  -t $PORT \
  > "$HOME/rigctld-9700.log" 2>&1 &

echo "started rigctld-9700 pid=$!"

