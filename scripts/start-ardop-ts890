#!/usr/bin/env bash
set -euo pipefail

if pgrep -x ardopcf >/dev/null; then
  echo "ardopcf already running"
  exit 0
fi

CARD=$(basename "$(readlink -f /dev/snd/by-radio/ts890-control)" | sed 's/controlC//')
echo "CARD=$CARD"

nohup ardopcf 8515 "plughw:${CARD},0" "plughw:${CARD},0" \
  > "$HOME/ardop-ts890.log" 2>&1 &

echo "started ardopcf pid=$!"

